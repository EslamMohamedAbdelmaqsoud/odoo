<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="school_order_tree_view" model="ir.ui.view">
        <field name="name">school order tree</field>
        <field name="model">school.order</field>
        <field name="arch" type="xml">
            <tree string="Orders" class="header_custom">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="order_date"/>
                <field name="total_order" sum="Total Order"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="school_order_form_view" model="ir.ui.view">
        <field name="name">school order form</field>
        <field name="model">school.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <!-- Buttons for confirming and canceling the order -->
                    <button name="action_confirm_order" string="Confirm Order" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel_order" string="Cancel Order" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="order_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_order" class="oe_subtotal_footer_separator" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="order_search_view" model="ir.ui.view">
        <field name="name">order search</field>
        <field name="model">school.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="order_action" model="ir.actions.act_window">
        <field name="name">order</field>
        <field name="res_model">school.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Sub Menu Items Of Orders -->
    <menuitem id="order_menu_item"
              name="Order"
              parent="orders_menu"
              action="order_action"/>

</odoo>