<odoo>
    <!-- Add PM Plans and Readings to Equipment Form -->
    <record id="hr_equipment_view_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="PM Plans &amp; Readings">
                    <group>
                        <field name="current_reading"/>
                        <field name="reading_uom"/>
                    </group>
                    <field name="pm_plan_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="interval"/>
                            <field name="last_maintenance_reading" readonly="1"/>
                        </tree>
                        <form>
                            <group>
                                <field name="name"/>
                                <field name="interval"/>
                                <field name="last_maintenance_reading"/>
                            </group>
                            <separator string="Tasks"/>
                            <field name="task_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                            <separator string="Spare Parts"/>
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add Planned    Tasks Tab to Maintenance Request Form -->
    <record id="hr_equipment_request_view_form_tasks_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.tasks.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Planned Tasks" name="planned_tasks" invisible="maintenance_type != 'preventive'">
                    <field name="task_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="is_done"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Add Spare Parts Tab to Maintenance Request Form -->
    <record id="hr_equipment_request_view_form_parts_inherit" model="ir.ui.view">
        <field name="name">maintenance.request.form.parts.inherit</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Spare Parts" name="spare_parts_dispatched">
                    <field name="part_ids">
                        <tree editable="bottom">
                            <field name="product_id"/>
                            <field name="qty"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_equipment_planned_maintenance" model="ir.actions.act_window">
        <field name="name">Planned Maintenance</field>
        <field name="res_model">maintenance.request</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('equipment_id', '=', active_id), ('maintenance_type', '=', 'preventive')]</field>
        <field name="context">{'default_equipment_id': active_id, 'default_maintenance_type': 'preventive'}</field>
    </record>

    <record id="view_equipment_form_inherit" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.inherit</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(action_equipment_planned_maintenance)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-calendar">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Planned Maintenance.</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>