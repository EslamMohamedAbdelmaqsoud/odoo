<odoo>

    <!-- Report Action -->
    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">appointment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic_management_system.report_prescription_template</field>
        <field name="report_file">clinic_management_system.report_prescription_template</field>
        <field name="print_report_name">'Prescription - %s' % (object.patient_id.name)</field>
        <field name="binding_model_id" ref="model_appointment"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_prescription_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h2>Medical Prescription</h2>
                            <hr/>
                        </div>

                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Patient:</strong>
                                <span t-field="o.patient_id.name"/>
                                <br/>
                                <strong>Age:</strong>
                                <span t-field="o.patient_id.age"/>
                                <br/>
                                <strong>Reference:</strong>
                                <span t-field="o.patient_id.reference"/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Date:</strong>
                                <span t-field="o.appointment_time"/>
                                <br/>
                                <strong>Doctor:</strong>
                                <span t-field="o.doctor_id.name"/>
                            </div>
                        </div>

                        <div class="mt-5">
                            <h4>Rx / Prescription:</h4>
                            <div style="border: 1px solid #eee; padding: 20px; min-height: 300px;">
                                <span t-field="o.prescription"/>
                            </div>
                        </div>

                        <div class="mt-5 text-end">
                            <p>Doctor's Signature: _________________</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

