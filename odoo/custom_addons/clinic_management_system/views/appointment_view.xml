<odoo>
    <!-- Tree View -->
    <record id="appointment_tree_view" model="ir.ui.view">
        <field name="name">appointment tree view</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'done'">
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="appointment_time"/>
                <field name="state" widget="badge" decoration-info="state == 'confirmed'"
                       decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="appointment_form_view" model="ir.ui.view">
        <field name="name">appointment form view</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <form>
                <!-- Header with action buttons and status bar ( work flow ) -->
                <header>
                    <button name="%(clinic_management_system.action_cancel_appointment_wizard)d"
                            string="Cancel Appointment"
                            type="action"
                            context="{'default_appointment_id': active_id}"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <!-- Adding ribbons to indicate the status of the appointment -->
                    <widget name="web_ribbon" title="Cancelled" bg_color="bg-danger" invisible="state != 'cancel'"/>
                    <widget name="web_ribbon" title="Done" bg_color="bg-success" invisible="state != 'done'"/>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="appointment_time"/>
                        </group>
                    </group>
                    <!-- Adding a notebook for prescription and medical notes -->
                    <notebook>
                        <page string="Prescription" name="prescription">
                            <field name="prescription" placeholder="Write medical notes here..."/>
                        </page>
                    </notebook>
                </sheet>
                <!--Adding Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="appointment_kanban_view" model="ir.ui.view">
        <field name="name">appointment kanban view</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="patient_id"/>
                                </strong>
                                <div>
                                    <field name="doctor_id"/>
                                </div>
                                <div>
                                    <i>
                                        <field name="appointment_time"/>
                                    </i>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="appointment_calendar_view" model="ir.ui.view">
        <field name="name">appointment calendar view</field>
        <field name="model">appointment</field>
        <field name="arch" type="xml">
            <calendar string="Appointments" date_start="appointment_time" color="doctor_id" mode="month"
                      quick_create="0">
                <field name="patient_id"/>
                <field name="doctor_id" avatar_field="image_128"/>
            </calendar>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_appointment" model="ir.actions.act_window">
        <field name="name">Appointments</field>
        <field name="res_model">appointment</field>
        <field name="view_mode">tree,form,kanban,calendar</field>
    </record>

    <!-- ( cron jobs ) Scheduled Action to Cancel Expired Appointments -->
    <record id="ir_cron_cancel_expired_appointments" model="ir.cron">
        <field name="name">Clinic: Cancel Expired Appointments</field>
        <field name="model_id" ref="model_appointment"/>
        <field name="state">code</field>
        <field name="code">model.cron_cancel_expired_appointments()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <!-- Email Template for Appointment Confirmation -->
    <record id="email_template_appointment_confirmation" model="mail.template">
        <field name="name">Appointment: Confirmation</field>
        <field name="model_id" ref="clinic_management_system.model_appointment"/>
        <field name="subject">Confirmation of your appointment: {{ object.patient_id.name }}</field>
        <field name="email_from">{{ object.doctor_id.email_formatted }}</field>
        <field name="email_to">{{ object.patient_id.email }}</field>
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p>Dear<t t-out="object.patient_id.name"/>,
                </p>
                <p>Your appointment has been confirmed for
                    <strong>
                        <t t-out="object.appointment_time"/>
                    </strong>
                    .
                </p>
                <p>Thank you for choosing our clinic!</p>
            </div>
        </field>
    </record>

    <!-- Sub Menu Items Of Appointments -->
    <menuitem id="menu_appointment_item"
              name="All Appointments"
              parent="menu_appointment_master"
              action="action_appointment"
              sequence="10"/>

</odoo>