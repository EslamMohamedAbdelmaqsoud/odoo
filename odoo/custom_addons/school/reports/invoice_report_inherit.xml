<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_inherit_barcode" inherit_id="account.report_invoice_document">

            <xpath expr="//table[@name='invoice_line_table']/thead/tr/th[@name='th_description']" position="after">
                <th name="th_barcode" class="text-start">
                    <span>Barcode</span>
                </th>
            </xpath>

            <xpath expr="//table[@name='invoice_line_table']/tbody//td[@name='account_invoice_line_name']"
                   position="after">
                <td name="td_barcode">
                    <span t-field="line.product_id.barcode"/>
                </td>
            </xpath>

        </template>
    </data>
</odoo>
