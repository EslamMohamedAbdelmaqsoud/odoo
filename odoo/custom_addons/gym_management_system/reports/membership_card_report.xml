<odoo>
    <record id="action_report_membership_card" model="ir.actions.report">
        <field name="name">Membership Card</field>
        <field name="model">gym.membership</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gym_management_system.report_membership_card_template</field>
        <field name="print_report_name">'Card - %s' % (object.member_id.name)</field>
        <field name="binding_model_id" ref="model_gym_membership"/>
    </record>

    <template id="report_membership_card_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="border: 2px solid #333; padding: 20px; width: 300px; border-radius: 10px;">
                        <h3 class="text-center">Gym Member Card</h3>
                        <hr/>
                        <p>
                            <strong>Name:</strong>
                            <t t-esc="o.member_id.name"/>
                        </p>
                        <p>
                            <strong>ID:</strong>
                            <t t-esc="o.member_id.member_id"/>
                        </p>
                        <p>
                            <strong>Package:</strong>
                            <t t-esc="o.package_id.name"/>
                        </p>
                        <p>
                            <strong>Expires:</strong>
                            <t t-esc="o.end_date"/>
                        </p>
                        <div class="text-center">
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>