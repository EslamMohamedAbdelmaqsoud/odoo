<odoo>

    <record id="view_account_form_inherit" model="ir.ui.view">
        <field name="name">account move form inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_do_something" type="object" class="oe_highlight" string="Do SomeThing"/>
            </xpath>

            <!-- إضافة الحقول المخصصة في نموذج الفاتورة -->
            <xpath expr="//field[@name='delivery_date']" position="after">
                <field name="internal_reference"/>
                <field name="department"/>
                <field name="cost_center"/>
            </xpath>

            <!-- إضافة صفحة جديدة للملاحظات -->
            <xpath expr="//notebook" position="inside">
                <page string="News 2026">
                    <group>
                        <group>
                            <field name="custom_notes"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>