<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_biotime_attendance" model="ir.cron">
            <field name="name">حسّاب الحضور: سحب البصمات الخام (يومياً 12 ليلاً)</field>
            <field name="model_id" ref="model_biotime_sync_provider"/>
            <field name="state">code</field>
            <field name="code">model.search([]).fetch_biotime_attendance()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall"
                   eval="(datetime.now().replace(hour=21, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>